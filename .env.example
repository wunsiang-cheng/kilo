# Kilo configuration. Copy to `.env` in the directory you start Kilo from.
# Every value below is optional except credentials for the model; the defaults are shown.

# --- Model (OpenRouter) ------------------------------------------------------
# Required: kilo-server will not start without an OpenRouter API key (https://openrouter.ai/settings/keys).
# OPENROUTER_API_KEY=sk-or-v1-...
# Any model id listed on https://openrouter.ai/models
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor
# max | xhigh | high | medium | low | minimal | none. Not every model offers every level; some cannot turn reasoning off.
OPENROUTER_REASONING_EFFORT=high
# Cap on one reply, reasoning included. Unset: the model's own limit. The conversation and the cap together must fit
# in the model's context, or the request is refused.
# OPENROUTER_MAX_TOKENS=

# --- Server and login --------------------------------------------------------
# Whoever logs in controls the agent's unrestricted shell. The default password is public: it works
# only from this computer, and the server will not start on another KILO_HOST with it. Serving beyond
# localhost, set your own password and put HTTPS in front.
KILO_HOST=127.0.0.1
KILO_PORT=8000
# The web terminal's only user.
KILO_USERNAME=drg@drg.best
KILO_PASSWORD=9487skrskr

# --- Paths -------------------------------------------------------------------
# The agent's working directory: relative paths in every tool resolve here.
KILO_WORKSPACE=~/kilo-workspace
# Databases, task logs, saved tool output, MCP logs and the LINE browser profile.
KILO_DATA_DIR=.kilo_data
# MCP server definitions ({"mcpServers": {...}}). Default: mcp_servers.json in KILO_DATA_DIR.
# KILO_MCP_CONFIG=.kilo_data/mcp_servers.json

# --- Tools -------------------------------------------------------------------
# Seconds a foreground shell command may run by default.
KILO_DEFAULT_TIMEOUT=600
# Largest tool result the model sees, in characters (minimum 10000). Longer output is shortened
# and saved in full under <data dir>/tool-output.
KILO_TOOL_OUTPUT_MAX_CHARS=100000

# --- Context compaction ------------------------------------------------------
# A conversation this large (tokens) is summarized before its next request. 0 turns it off; otherwise at least 10000.
# Keep it well below the model's context length (OpenRouter lists it for each model): the summary request carries the
# whole conversation. Lower it when you switch to a model with a smaller context.
# Each request resends the whole conversation, so a lower value costs less per turn but summarizes sooner.
KILO_COMPACT_AT_TOKENS=500000
# Cap on one summary, reasoning included. At most 64000: a summary cut off is retried with twice this.
KILO_COMPACT_MAX_TOKENS=16000

# --- Scheduled jobs ----------------------------------------------------------
# IANA timezone that schedules use unless they name another.
KILO_TIMEZONE=Asia/Taipei
# A run missed by more than this many minutes (server was down) is skipped.
KILO_JOB_CATCHUP_MINUTES=5

# --- Telegram (optional) ----------------------------------------------------
# A bot from @BotFather. Unset: no bot. The bot runs inside kilo-server and polls Telegram.
# KILO_TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ids allowed to use it, comma-separated (required with a token).
# Messages from anyone else are ignored, and logged with the sender's id.
# KILO_TELEGRAM_ALLOWED_USERS=
# Group chat ids (negative) it may be used in, comma-separated; it leaves any other group, logging its id.
# KILO_TELEGRAM_ALLOWED_CHATS=

# --- LINE (optional) ---------------------------------------------------------
# Read by the LINE MCP server, not by Kilo itself; it also uses
# KILO_DATA_DIR and KILO_TIMEZONE. It needs `kilo-line-browser` running.
# DevTools address of the dedicated Chrome; must be a local address with a port.
KILO_LINE_CDP_URL=http://127.0.0.1:9333
# The account lists: "chats" (the only chats Kilo may use; empty means none, ["*"] means EVERY chat), and the display names of
# "managers", "colleagues" and "bots". Exact names, as JSON. Written empty on first start when missing, read
# again whenever it changes. See the README. Default: line_accounts.json in KILO_DATA_DIR.
# KILO_LINE_ACCOUNTS=.kilo_data/line_accounts.json
# Tests only: messages from the account itself that start with this are treated as a contact's.
# KILO_LINE_TEST_PREFIX=
